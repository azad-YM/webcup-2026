# Racine HTTP de l'API (endpoints IAM)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8083/api

# URL publique du site (formulaire de connexion unique)
NEXT_PUBLIC_SITE_URL=http://localhost:5178

# URL de l'application admin
NEXT_PUBLIC_ADMIN_URL=http://localhost:5179

# Temps réel (ADR 004) : transport (mercure | pusher | none) et URL d’abonnement (hub Mercure)
NEXT_PUBLIC_REALTIME_TRANSPORT=mercure
NEXT_PUBLIC_REALTIME_URL=http://localhost:3333/.well-known/mercure
