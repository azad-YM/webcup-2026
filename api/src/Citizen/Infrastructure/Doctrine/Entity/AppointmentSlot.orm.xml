<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\AppointmentSlot" table="citizen_appointment_slots">
        <indexes>
            <index name="IDX_APPOINTMENT_SLOT_START" columns="starts_at"/>
            <index name="IDX_APPOINTMENT_SLOT_SERVICE" columns="service_id,starts_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="UNIQ_APPOINTMENT_SLOT_BOOKING" columns="appointment_id"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="serviceId" column="service_id" type="string" length="100"/>
        <field name="serviceName" column="service_name" type="string" length="200"/>
        <field name="startsAt" column="starts_at" type="datetime_immutable"/>
        <field name="durationMinutes" column="duration_minutes" type="integer"/>
        <field name="location" type="string" length="255"/>
        <field name="instructions" type="text"/>
        <field name="appointmentId" column="appointment_id" type="string" length="36" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="version" type="integer" version="true"/>
    </entity>
</doctrine-mapping>
