<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\Appointment" table="citizen_appointments">
        <indexes>
            <index name="IDX_APPOINTMENT_CITIZEN" columns="citizen_id,starts_at"/>
            <index name="IDX_APPOINTMENT_STATUS_START" columns="status,starts_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="UNIQ_APPOINTMENT_REFERENCE" columns="reference"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="reference" type="string" length="20"/>
        <field name="citizenId" column="citizen_id" type="string" length="36"/>
        <field name="slotId" column="slot_id" type="string" length="36"/>
        <field name="serviceId" column="service_id" type="string" length="100"/>
        <field name="serviceName" column="service_name" type="string" length="200"/>
        <field name="startsAt" column="starts_at" type="datetime_immutable"/>
        <field name="durationMinutes" column="duration_minutes" type="integer"/>
        <field name="location" type="string" length="255"/>
        <field name="instructions" type="text"/>
        <field name="status" type="string" length="20"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <field name="dayBeforeRemindedAt" column="day_before_reminded_at" type="datetime_immutable" nullable="true"/>
        <field name="twoHoursRemindedAt" column="two_hours_reminded_at" type="datetime_immutable" nullable="true"/>
        <field name="version" type="integer" version="true"/>
    </entity>
</doctrine-mapping>
