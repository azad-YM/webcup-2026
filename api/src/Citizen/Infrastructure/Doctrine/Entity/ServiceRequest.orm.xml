<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\ServiceRequest" table="citizen_service_requests">
        <indexes>
            <index name="IDX_SERVICE_REQUEST_CITIZEN" columns="citizen_id,created_at"/>
            <index name="IDX_SERVICE_REQUEST_STATUS" columns="status,created_at"/>
            <index name="IDX_SERVICE_REQUEST_PRIORITY" columns="priority_rank,created_at"/>
            <index name="IDX_SERVICE_REQUEST_GROUP" columns="group_id"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="citizenId" column="citizen_id" type="string" length="36"/>
        <field name="reference" type="string" length="20" unique="true"/>
        <field name="type" type="string" length="20"/>
        <field name="serviceId" column="service_id" type="string" length="100" nullable="true"/>
        <field name="subject" type="string" length="160"/>
        <field name="description" type="text"/>
        <field name="location" type="string" length="255" nullable="true"/>
        <field name="status" type="string" length="20"/>
        <field name="steps" type="json"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <field name="version" type="integer" version="true"/>
        <field name="isPublic" column="is_public" type="boolean">
            <options><option name="default">0</option></options>
        </field>
        <field name="priority" type="string" length="10">
            <options><option name="default">normal</option></options>
        </field>
        <field name="priorityRank" column="priority_rank" type="smallint">
            <options><option name="default">2</option></options>
        </field>
        <field name="priorityReason" column="priority_reason" type="string" length="255" nullable="true"/>
        <field name="prioritySource" column="priority_source" type="string" length="10">
            <options><option name="default">auto</option></options>
        </field>
        <field name="category" type="string" length="30">
            <options><option name="default">other</option></options>
        </field>
        <field name="district" type="string" length="100" nullable="true"/>
        <field name="medicalEmergency" column="medical_emergency" type="boolean">
            <options><option name="default">0</option></options>
        </field>
        <field name="emergencyHandledAt" column="emergency_handled_at" type="datetime_immutable" nullable="true"/>
        <field name="emergencyHandledBy" column="emergency_handled_by" type="string" length="36" nullable="true"/>
        <field name="groupId" column="group_id" type="string" length="36" nullable="true"/>
    </entity>
</doctrine-mapping>
