<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
<entity name="Citizen\Domain\Entity\ServiceRequest" table="citizen_service_requests">
<id name="id" type="string" length="36"/>
<field name="citizenId" column="citizen_id" type="string" length="36"/>
<field name="reference" type="string" length="50" unique="true"/>
<field name="type" type="string" length="20"/>
<field name="subject" type="string" length="160"/>
<field name="description" type="text"/>
<field name="location" type="string" length="255" nullable="true"/>
<field name="serviceId" column="service_id" type="string" length="100" nullable="true"/>
<field name="status" type="string" length="20"/>
<field name="steps" type="json"/>
<field name="version" type="integer" version="true"/>
<field name="createdAt" column="created_at" type="datetime_immutable"/>
<indexes><index name="IDX_REQUEST_CITIZEN" columns="citizen_id,created_at"/><index name="IDX_REQUEST_STATUS" columns="status,created_at"/></indexes>
</entity></doctrine-mapping>
