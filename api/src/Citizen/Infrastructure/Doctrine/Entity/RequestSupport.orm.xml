<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\RequestSupport" table="citizen_request_supports">
        <indexes>
            <index name="IDX_REQUEST_SUPPORT_CITIZEN" columns="citizen_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="UNIQ_REQUEST_SUPPORT" columns="request_id,citizen_id"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="requestId" column="request_id" type="string" length="36"/>
        <field name="citizenId" column="citizen_id" type="string" length="36"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
