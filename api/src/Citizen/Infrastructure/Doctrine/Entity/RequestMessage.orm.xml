<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\RequestMessage" table="citizen_request_messages">
        <indexes>
            <index name="IDX_REQUEST_MESSAGE_REQUEST" columns="request_id,created_at"/>
            <index name="IDX_REQUEST_MESSAGE_CITIZEN" columns="citizen_id"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="requestId" column="request_id" type="string" length="36"/>
        <field name="citizenId" column="citizen_id" type="string" length="36"/>
        <field name="author" type="string" length="10"/>
        <field name="authorUserId" column="author_user_id" type="string" length="36" nullable="true"/>
        <field name="body" type="text"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
