<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Citizen\Domain\Entity\Citizen" table="citizens">
        <id name="id" type="string" length="36"/>
        <field name="userId" column="user_id" type="string" length="36"/>
        <field name="registeredAt" column="registered_at" type="datetime_immutable"/>
        <field name="firstName" column="first_name" type="string" length="100" nullable="true"/>
        <field name="lastName" column="last_name" type="string" length="100" nullable="true"/>
        <field name="phone" type="string" length="30" nullable="true"/>
        <field name="address" type="string" length="255" nullable="true"/>
        <field name="district" type="string" length="100" nullable="true"/>
        <field name="preferredLanguage" column="preferred_language" type="string" length="5" nullable="true"/>
        <unique-constraints>
            <unique-constraint name="UNIQ_CITIZEN_USER" columns="user_id"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
