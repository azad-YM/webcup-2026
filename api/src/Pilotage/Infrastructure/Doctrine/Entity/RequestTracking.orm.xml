<?xml version="1.0" encoding="UTF-8" ?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Pilotage\Domain\Entity\RequestTracking" table="pilotage_request_tracking">
        <id name="requestCode" type="string" column="request_code" length="20" />
        <field name="status" type="string" column="status" length="16">
            <options><option name="default">todo</option></options>
        </field>
        <field name="links" type="json" column="links" />
        <field name="note" type="string" column="note" length="500">
            <options><option name="default"></option></options>
        </field>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />
        <field name="updatedById" type="string" column="updated_by_id" length="36" nullable="true" />
        <field name="updatedByName" type="string" column="updated_by_name" length="180" />
    </entity>
</doctrine-mapping>
