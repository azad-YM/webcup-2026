<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Shared\Infrastructure\RateLimit\RateLimitCounter" table="rate_limit_counter">
        <indexes>
            <index name="IDX_RATE_LIMIT_EXPIRES" columns="expires_at"/>
        </indexes>
        <id name="id" type="string" length="64"/>
        <field name="rule" type="string" length="60"/>
        <field name="hits" type="integer"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
