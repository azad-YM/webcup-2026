<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Shared\Infrastructure\Idempotency\IdempotencyKey" table="idempotency_keys">
        <indexes>
            <index name="IDX_IDEMPOTENCY_EXPIRES" columns="expires_at"/>
        </indexes>
        <id name="id" type="string" length="64"/>
        <field name="requestHash" column="request_hash" type="string" length="64"/>
        <field name="state" type="string" length="10">
            <options><option name="default">pending</option></options>
        </field>
        <field name="statusCode" column="status_code" type="smallint" nullable="true"/>
        <field name="body" type="text" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
