<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Shared\Infrastructure\Realtime\RealtimeEvent" table="realtime_event">
        <id name="id" type="bigint">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="topic" type="string" length="255"/>
        <field name="type" type="string" length="100"/>
        <field name="payload" type="json"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <indexes>
            <index name="IDX_REALTIME_EVENT_TOPIC_ID" columns="topic,id"/>
            <index name="IDX_REALTIME_EVENT_CREATED_AT" columns="created_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
