<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="IAM\Domain\Entity\LoginAttemptBucket" table="iam_login_attempt_buckets">
    <id name="id" type="string" length="64"/>
    <field name="attempts" type="integer"/>
    <field name="expiresAt" column="expires_at" type="integer"/>
    <indexes><index name="IDX_LOGIN_BUCKET_EXPIRY" columns="expires_at"/></indexes>
  </entity>
</doctrine-mapping>
