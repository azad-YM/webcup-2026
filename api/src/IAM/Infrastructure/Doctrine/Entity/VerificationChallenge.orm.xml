<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="IAM\Domain\Entity\VerificationChallenge" table="iam_verification_challenges">
    <indexes>
      <index name="IDX_IAM_CHALLENGE_USER" columns="user_id"/>
    </indexes>
    <id name="idHash" column="id_hash" type="string" length="64"/>
    <field name="userId" column="user_id" type="string" length="36"/>
    <field name="purpose" type="string" length="16"/>
    <field name="codeHash" column="code_hash" type="string" length="64"/>
    <field name="attempts" type="integer">
      <options><option name="default">0</option></options>
    </field>
    <field name="sends" type="integer">
      <options><option name="default">1</option></options>
    </field>
    <field name="lastSentAt" column="last_sent_at" type="integer"/>
    <field name="expiresAt" column="expires_at" type="integer"/>
    <field name="method" type="string" length="16" nullable="true"/>
    <field name="deviceHash" column="device_hash" type="string" length="64" nullable="true"/>
  </entity>
</doctrine-mapping>
