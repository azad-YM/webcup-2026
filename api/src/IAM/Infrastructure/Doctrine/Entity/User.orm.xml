<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="IAM\Domain\Entity\User" table="auth_users">
    <id name="id" type="string" length="36"/>
    <field name="email" type="string" unique="true"/>
    <field name="password" type="string"/>
    <field name="status" type="string" length="16">
        <options><option name="default">active</option></options>
    </field>
    <field name="sessionVersion" column="session_version" type="integer">
        <options><option name="default">0</option></options>
    </field>
    <field name="name" type="string" nullable="true"/>
    <field name="residentId" column="resident_id" type="string" length="12" nullable="true" unique="true"/>
    <field name="passwordChangeRequired" column="password_change_required" type="boolean">
        <options><option name="default">0</option></options>
    </field>
    <field name="emailVerification" column="email_verification" type="boolean">
        <options><option name="default">0</option></options>
    </field>
  </entity>
</doctrine-mapping>
