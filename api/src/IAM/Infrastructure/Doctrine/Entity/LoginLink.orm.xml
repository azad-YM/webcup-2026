<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="IAM\Domain\Entity\LoginLink" table="iam_login_links">
    <indexes>
      <index name="IDX_IAM_LOGIN_LINK_USER" columns="user_id,created_at"/>
    </indexes>
    <id name="tokenHash" column="token_hash" type="string" length="64"/>
    <field name="userId" column="user_id" type="string" length="36"/>
    <field name="browserHash" column="browser_hash" type="string" length="64"/>
    <field name="createdAt" column="created_at" type="integer"/>
    <field name="expiresAt" column="expires_at" type="integer"/>
  </entity>
</doctrine-mapping>
