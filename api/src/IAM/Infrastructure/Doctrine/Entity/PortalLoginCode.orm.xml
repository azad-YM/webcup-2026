<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="IAM\Domain\Entity\PortalLoginCode" table="iam_portal_login_codes">
    <id name="hash" type="string" length="64"/>
    <field name="userId" column="user_id" type="string" length="36"/>
    <field name="email" type="string"/>
    <field name="destination" type="string" length="32"/>
    <field name="challenge" type="string" length="43"/>
    <field name="sessionHash" column="session_hash" type="string" length="64"/>
    <field name="expiresAt" column="expires_at" type="integer"/>
    <field name="sessionExpiresAt" column="session_expires_at" type="integer"/>
  </entity>
</doctrine-mapping>
