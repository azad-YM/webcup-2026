<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Participation\Domain\Entity\Project" table="participation_projects">
        <indexes>
            <index name="IDX_PARTICIPATION_PROJECT_STATE" columns="state,updated_at"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="title" type="string" length="200"/>
        <field name="summary" type="text"/>
        <field name="description" type="json"/>
        <field name="district" type="string" length="40" nullable="true"/>
        <field name="status" type="string" length="20"/>
        <field name="steps" type="json"/>
        <field name="nextStep" column="next_step" type="string" length="500" nullable="true"/>
        <field name="state" type="string" length="20">
            <options><option name="default">draft</option></options>
        </field>
        <field name="publishedAt" column="published_at" type="datetime_immutable" nullable="true"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
