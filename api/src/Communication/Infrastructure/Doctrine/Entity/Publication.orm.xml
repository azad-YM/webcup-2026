<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Communication\Domain\Entity\Publication" table="communication_publication">
        <!-- F78 (L24) : lectures publiques par état. -->
        <indexes><index name="IDX_COMMUNICATION_PUBLICATION_STATE" columns="state,published_at"/></indexes>
        <id name="id" type="string" length="80"/>
        <field name="title" type="string" length="200"/>
        <field name="category" type="string" length="80"/>
        <field name="summary" type="text"/>
        <field name="body" type="json"/>
        <field name="important" type="boolean"/>
        <field name="state" type="string" length="20"/>
        <field name="publishedAt" column="published_at" type="datetime_immutable" nullable="true"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <field name="plainLanguage" column="plain_language" type="string" length="600"><options><option name="default"></option></options></field>
    </entity>
</doctrine-mapping>
