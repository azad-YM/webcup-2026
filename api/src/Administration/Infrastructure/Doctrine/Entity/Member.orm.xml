<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="Administration\Domain\Entity\Member" table="admin_members">
        <id name="id" type="string" length="36"/>
        <field name="userId" column="user_id" type="string" length="36"/>
        <field name="name" type="string"/>
        <field name="roleIds" column="role_ids" type="json"/>
        <field name="active" type="boolean"/>
        <unique-constraints>
            <unique-constraint name="UNIQ_ADMIN_MEMBER_USER" columns="user_id"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
