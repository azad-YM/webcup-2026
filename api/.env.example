APP_ENV=dev
APP_SECRET=change-me
DATABASE_URL="mysql://novaterra:novaterra@db:3306/novaterra?serverVersion=8.4.0&charset=utf8mb4"
MYSQL_DATABASE=novaterra
MYSQL_USER=novaterra
MYSQL_PASSWORD=novaterra
MYSQL_ROOT_PASSWORD=root
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
MAILER_DSN="smtp://mailpit:1025"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# API du concours Webcup (BC Pilotage). Définir la vraie clé dans .env.local, jamais ici.
WEBCUP_API_URL=https://24h.webcup.fr/wp-json/webcup/v1/requests
WEBCUP_API_KEY=

# Temps réel (ADR 004) : REALTIME_TRANSPORT = mercure | pusher | none. Sans secret ni identifiants,
# la publication est désactivée sans erreur. Définir les vraies valeurs dans .env.local.
REALTIME_TRANSPORT=mercure
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_JWT_SECRET=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
