APP_ENV=dev
APP_SECRET=change-me
DATABASE_URL="mysql://novaterra:novaterra@db:3306/novaterra?serverVersion=8.4.0&charset=utf8mb4"
MYSQL_DATABASE=novaterra
MYSQL_USER=novaterra
MYSQL_PASSWORD=novaterra
MYSQL_ROOT_PASSWORD=root
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
MAILER_DSN="smtp://mailpit:1025"
# L15 : expéditeur des e-mails de sécurité et adresse publique du site (liens des e-mails).
MAILER_FROM="Mairie de Nova Terra <no-reply@nova-terra.local>"
SITE_URL=http://localhost:5178
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# API du concours Webcup (BC Pilotage). Définir la vraie clé dans .env.local, jamais ici.
WEBCUP_API_URL=https://24h.webcup.fr/wp-json/webcup/v1/requests
WEBCUP_API_KEY=

# Temps réel (ADR 004) : REALTIME_TRANSPORT = database (défaut : buffer + SSE de l'API) | mercure | pusher | none.
# Mercure et Pusher sont des adaptateurs optionnels non utilisés pour le concours ; sans secret ni identifiants,
# leur publication est désactivée sans erreur. Définir les vraies valeurs dans .env.local.
REALTIME_TRANSPORT=database
REALTIME_STREAM_SECONDS=20
MERCURE_URL=
MERCURE_JWT_SECRET=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
